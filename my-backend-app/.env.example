# Environment configuration — copy to .env and adjust values.
# Never commit real credentials; .env is git-ignored.

# TCP port for the API server
PORT=3000

# Network interface to bind
HOST=0.0.0.0

# development | test | production
NODE_ENV=development

# Origin allowed by CORS (use * for local mobile development)
CORS_ORIGIN=*

# Max requests per client per 15-minute window
RATE_LIMIT_MAX=300

# debug | info | warn | error
LOG_LEVEL=info
